@page "{id:int}"
@model DOTNET.Pages.Events.EditModel
@{
    ViewData["Title"] = "Upravit událost";
}
<h2>Upravit událost</h2>
<form method="post">
    <div class="form-group">
        <label>Titulek</label>
        <input asp-for="Event.Title" class="form-control" />
    </div>
    <div class="form-group">
        <label>Začátek</label>
        <input asp-for="Event.StartTime" type="datetime-local" class="form-control" />
    </div>
    <div class="form-group">
        <label>Konec</label>
        <input asp-for="Event.EndTime" type="datetime-local" class="form-control" />
    </div>
    <div class="form-group">
        <label>Popis</label>
        <textarea asp-for="Event.Description" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Uložit změny</button>
</form>
<a asp-page="index">Zpět</a>
