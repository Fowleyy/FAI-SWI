@page
@model DOTNET.Pages.DeleteModel

<h2>Smazat událost</h2>

<form method="post">
    <div class="form-group">
        <label>Název</label>
        <div>@Model.Event.Title</div>
    </div>
    <div class="form-group">
        <label>Datum</label>
        <div>@Model.Event.StartTime.ToString("dd.MM.yyyy")</div>
    </div>
    <button type="submit" class="btn btn-danger">Smazat</button>
</form>
